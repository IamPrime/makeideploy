{
  "name": "makeideploy",
  "description": "Make I Deploy Today?",
  "author": "IamPrime",
  "license": "WTFPL",
  "version": "2.0.0",
  "repository": "https://github.com/IamPrime/makeideploy",
  "scripts": {
    "precommit": "NODE_ENV=production lint-staged",
    "dev": "next -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "lint": "next lint --dir  pages --dir component --dir helpers --dir tests",
    "format": "prettier-eslint --write $PWD/'**/*.js'",
    "generate:icons": "python extension/generate-icons.py",
    "build:extension": "python extension/build-extension.py"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^1.0.0",
    "date-fns": "^4.1.0",
    "next": "^16.1.7",
    "prettier-eslint-cli": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@types/jest": "^29.5.12",
    "@types/node": "22.9.0",
    "@types/react": "18.3.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.7",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.0",
    "husky": "^9.1.5",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.6.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run lint"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "minimatch@9.0.3": "9.0.9"
  }
}
