{
  "manifest_version": 3,
  "name": "Make I Deploy Today?",
  "version": "1.0.0",
  "description": "Quick decision helper - Make I deploy today? Get instant Pidgin wisdom!",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Make I deploy today?",
    "default_popup": "popup.html",
    "default_icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "https://makeideploy.today/*"
  ]
}
